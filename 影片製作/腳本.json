   "hourGust": {"-12": 9.5, "-11": 10.2, "-10": 11, "-9": 11.8, "-8": 12.6, "-7": 13.4, "-6": 14.2, "-5": 15.1, "-4": 15.8, "-3": 16.6, "-2": 17.3, "-1": 18.2, "0": 17.6, "1": 18.4, "2": 19.5, "3": 19.1, "4": 18, "5": 16.8, "6": 15.5, "7": 14, "8": 12.8, "9": 11.5, "10": 10.6, "11": 9.8, "12": 9},
